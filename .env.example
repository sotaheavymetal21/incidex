# Database Configuration
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=incidex
DATABASE_URL=postgres://user:password@postgres:5432/incidex?sslmode=disable

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# MinIO Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# JWT Configuration
JWT_SECRET=super-secret-key-change-me-in-production

# Server Configuration
PORT=8080

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Initial Admin User (created on first startup if no users exist)
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=admin123
INITIAL_ADMIN_NAME=Admin User

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3000

# Database Migration Configuration
# Set to "true" to automatically run migrations on application startup
AUTO_MIGRATE=true
# Directory containing migration files (relative to application root)
MIGRATIONS_DIR=./migrations
