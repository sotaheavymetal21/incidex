# ==============================================
# SECURITY NOTICE
# ==============================================
# ALL VALUES IN THIS FILE ARE EXAMPLES ONLY.
# DO NOT use these values in production!
# For production, use strong, randomly generated values
# and manage secrets with a secret manager (e.g., AWS Secrets Manager, HashiCorp Vault)
# ==============================================

# Environment
# Options: development, production
APP_ENV=development

# Database Configuration (REQUIRED)
# For local development
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=incidex
DATABASE_URL=postgres://user:password@postgres:5432/incidex?sslmode=disable

# Production: Use strong passwords and enable SSL
# DATABASE_URL=postgres://user:STRONG_PASSWORD@host:5432/incidex?sslmode=require

# Redis Configuration (REQUIRED)
REDIS_URL=redis://redis:6379/0

# MinIO Configuration (REQUIRED)
# For Docker setup
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Production: Use strong, unique credentials
# MINIO_ACCESS_KEY=your-strong-access-key
# MINIO_SECRET_KEY=your-strong-secret-key-min-32-chars

# JWT Configuration (REQUIRED)
# CRITICAL: Must be at least 32 characters long
# Generate with: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-must-be-at-least-32-characters-long-change-in-production

# Production example:
# JWT_SECRET=kX8hP2mN9qR5tY7wE3bV6cA1dF4gH8jL0sZ2xC5vB7nM9kQ3pR6tY8wE1aD4fG7h

# Server Configuration
PORT=8080

# CORS Configuration (REQUIRED)
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Production example:
# CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# Frontend URL (REQUIRED)
# Used for email links and redirects
FRONTEND_URL=http://localhost:3000

# Production example:
# FRONTEND_URL=https://yourdomain.com

# Initial Admin User (OPTIONAL)
# Only used on first startup if no users exist
# Leave empty to skip initial admin creation
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=

# Database Migration Configuration
# Set to "true" to automatically run migrations on application startup
AUTO_MIGRATE=true
# Directory containing migration files (relative to application root)
MIGRATIONS_DIR=./migrations

# ========================================
# Logging Configuration (OPTIONAL)
# ========================================

# Application Log Level (OPTIONAL)
# Controls the verbosity of application logs
# Options: debug, info, warn, error, fatal, panic
# Default: "info" for production, "debug" for development
# - debug: Very detailed logs for debugging (use in development only)
# - info: General informational messages
# - warn: Warning messages (potential issues)
# - error: Error messages (failures that don't stop the app)
# - fatal: Critical errors that stop the application
LOG_LEVEL=debug

# Stack Trace Logging (OPTIONAL)
# Controls whether to include stack traces in error logs
# Options: true, false
# Default: false for production (security), true for development (debugging)
# WARNING: In production, stack traces can expose internal implementation details
LOG_STACKTRACE=true

# Database Query Logging Level (OPTIONAL)
# Controls the verbosity of database query logs
# Options: silent, error, warn, info
# Default: "warn" (recommended for both development and production)
# - silent: No database logs
# - error: Only log database errors
# - warn: Log errors and slow queries (>200ms) - RECOMMENDED
# - info: Log all queries with masked sensitive data (use for debugging only)
# WARNING: "info" level generates excessive logs and may impact performance
DB_LOG_LEVEL=warn

# Test User Password (OPTIONAL - for seeding test data)
# Used only when running `make seed` or `make seed-force`
# If not set, default password "admin1234" will be used for local development
TEST_USER_PASSWORD=

# ========================================
# SMTP Configuration (OPTIONAL)
# ========================================
# Email notification settings
# If not configured, email notifications will be logged instead of sent

# SMTP server hostname (e.g., smtp.gmail.com, smtp.sendgrid.net)
SMTP_HOST=

# SMTP server port (typically 587 for TLS, 465 for SSL, 25 for unencrypted)
SMTP_PORT=587

# SMTP authentication username
SMTP_USERNAME=

# SMTP authentication password
# For Gmail, use App Password instead of regular password
SMTP_PASSWORD=

# Email address to send from (e.g., noreply@yourdomain.com)
SMTP_FROM=

# ========================================
# Slack Notification (OPTIONAL)
# ========================================
# Slack webhook URL for notifications
# Create at: https://api.slack.com/messaging/webhooks
# Note: This is typically configured per-user in the application settings
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
